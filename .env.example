# Public installs bind to localhost by default. Use a private LAN address only when a remote client needs access.
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8000

# Optional deployment overrides. Leave unset for the default .env and named model volume.
# TTS_ENV_FILE=/absolute/path/to/bridge.env
# TTS_MODELS_PATH=/absolute/path/to/models

# Optional bearer token. Set it when binding outside localhost.
TTS_API_KEY=

# Pinned Silero RU v5.5 artifact. The defaults are already built into the image.
SILERO_MODEL_PATH=/models/v5_5_ru.pt
SILERO_MODEL_URL=https://models.silero.ai/models/tts/ru/v5_5_ru.pt
SILERO_MODEL_SHA256=50081637b602126ee06cb3bc8a744d25651d2da149ee8864b9a379bfdd934437

# Production-compatible defaults from the original OpenCodeBot TTS deployment.
SILERO_CPU_THREADS=6
SILERO_SAMPLE_RATE=48000
SILERO_MAX_CHUNK_CHARS=300
SILERO_SILENCE_SECONDS=0.12
SILERO_INTENSITY=3
SILERO_PEAK_CEILING=0.98
OPUS_BITRATE=48k
TTS_MAX_INPUT_CHARS=12000
TTS_MAX_OUTPUT_BYTES=20971520
TTS_MAX_PENDING=8
TTS_WARMUP=true
FFMPEG_TIMEOUT_SECONDS=120
